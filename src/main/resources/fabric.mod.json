{
	"schemaVersion": 1,
	"id": "bvr-core",
	"version": "${version}",
	"name": "BVR Core",
	"description": "Better Vanilla Romania: comenzi scurte si ceas real pentru datapack-ul Reborn (doar server).",
	"authors": [
		"Adytzu"
	],
	"contact": {
		"homepage": "https://github.com/AdytzuCriss/BVR-Core",
		"sources": "https://github.com/AdytzuCriss/BVR-Core"
	},
	"license": "CC0-1.0",
	"icon": "assets/bvr-core/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"adytzu.bvrcore.BVRCore"
		],
		"client": [
			"adytzu.bvrcore.client.BVRCoreClient"
		]
	},
	"mixins": [
		"bvr-core.mixins.json",
